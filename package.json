{
  "name": "soundlane",
  "version": "1.8.1",
  "description": "SoundLane – phát nhạc nhiều kênh cho sự kiện",
  "main": "main.js",
  "author": "SoundLane",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.soundlane.app",
    "productName": "SoundLane",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "app.js",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SoundLane-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "SoundLane-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}