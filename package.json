{
  "name": "event-deck",
  "version": "1.0.0",
  "description": "Phần mềm phát nhạc nhiều kênh cho sự kiện",
  "main": "main.js",
  "author": "Event Deck",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.eventdeck.app",
    "productName": "Event Deck",
    "files": ["main.js", "index.html", "style.css", "app.js", "package.json"],
    "win": { "target": ["portable", "nsis"], "artifactName": "EventDeck-${version}-${target}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
